# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=hermex-voice

# Existing Hermex Cognitive Core OpenAI-compatible base URL.
# The voice agent appends /chat/completions through the LiveKit OpenAI plugin.
HERMES_COGNITIVE_URL=http://127.0.0.1:8642/v1
HERMES_COGNITIVE_API_KEY=
HERMES_COGNITIVE_MODEL=hermes

# Voice defaults
HERMEX_DEFAULT_VOICE=rounded
HERMEX_DEFAULT_LANGUAGE=en-GB
HERMEX_DEFAULT_PACE=normal

# HTTP API
VOICE_API_HOST=0.0.0.0
VOICE_API_PORT=8788
VOICE_ALLOWED_ORIGINS=https://hermex-voice-agent--jishnupgtech.replit.app
VOICE_TOKEN_TTL_SECONDS=600
VOICE_SESSION_TTL_SECONDS=3600

# Optional shared frontend auth. Set a strong value in production.
VOICE_API_SHARED_SECRET=

LOG_LEVEL=INFO
