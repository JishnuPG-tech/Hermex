# ==============================================================================
# Hermes Agent — Standalone Space Secrets Reference
# Copy to HF Space settings -> Variables and secrets.
# All values are optional; defaults are baked into entrypoint.sh.
# ==============================================================================

# OmniRoute AI Gateway connection (Hermes LLM brain)
OMNIROUTE_BASE_URL=https://jishnupg-opencode-cli.hf.space/v1
OMNIROUTE_API_KEY=sk-2e556e0437ee2958-7baf2d-b4133935

# Default model routed through OmniRoute (auto/best-coding picks the best coding model)
HERMES_MODEL=auto/best-coding

# Bearer key clients use to call the Hermes API server.
# Defaults to OMNIROUTE_API_KEY when unset.
API_SERVER_KEY=

# Hermes agent API server port (internal, localhost only — do NOT expose)
HERMES_INTERNAL_PORT=8642

# Public gateway port (must match app_port in README metadata)
PUBLIC_PORT=7860

# --- Anthropic Messages bridge (for the patched Claude Android app) ---
# Upstream OpenAI-compatible endpoint the bridge forwards to.
# Defaults to the internal Hermes agent API server (localhost).
ANTHROPIC_BRIDGE_UPSTREAM_URL=http://127.0.0.1:8642/v1/chat/completions
ANTHROPIC_BRIDGE_UPSTREAM_KEY=
ANTHROPIC_BRIDGE_UPSTREAM_MODEL=auto/best-coding